#!/usr/bin/env sh
# Stores the Gmail app password in the system keyring, where Himalaya's config reads it, then checks
# that Himalaya can log in. The password is typed into secret-tool's own prompt and never printed.
#
# Create the app password first: https://myaccount.google.com/apppasswords (needs 2-step verification).
set -eu

account=${1:-gmail}
himalaya account list --json | grep -q "\"name\":\"$account\"" || {
  echo "Himalaya has no account \"$account\" — add [accounts.$account] to ~/.config/himalaya/config.toml first" >&2
  exit 1
}
secret-tool store --label="Himalaya $account" service himalaya account "$account"
himalaya account check --account "$account"
