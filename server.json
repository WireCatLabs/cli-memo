{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.wirecat/wirecat",
  "title": "WireCat",
  "description": "Local context for AI agents across messengers, mail and notes, from a local store. Set up the wcat CLI first.",
  "websiteUrl": "https://wirecat.dev/en/docs/wcat",
  "repository": {
    "url": "https://github.com/WireCatLabs/wirecat",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@wirecat/wirecat",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
