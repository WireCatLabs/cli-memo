{
  "name": "@wirecat/cli-memo",
  "version": "0.5.1",
  "description": "Context about people across messengers, notes and mail, from a local store",
  "license": "Apache-2.0",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/cli-memo.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.20.0",
  "bin": {
    "memo": "dist/bin/memo.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm secrets:scan",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "prepublishOnly": "pnpm build",
    "standards:check": "node config/wirecat/check.mjs",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint --config cspell.json --no-progress README.md"
  },
  "dependencies": {
    "@wirecat/cli-core": "0.18.1",
    "@wirecat/cli-messaging": "0.215.0",
    "commander": "15.0.0",
    "valibot": "1.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "5.0.3",
    "lefthook": "2.1.16",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "@cspell/dict-en-gb": "5.0.34",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.3",
    "cspell": "10.3.6",
    "markdownlint-cli2": "0.23.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
