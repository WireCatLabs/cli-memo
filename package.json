{
  "name": "@wirecat/cli-memo",
  "version": "0.25.0",
  "description": "Context about people across messengers, notes and mail, from a local store",
  "license": "Apache-2.0",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/cli-memo.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.20.0",
  "bin": {
    "memo": "dist/bin/memo.js"
  },
  "files": [
    "dist",
    "skills",
    "install",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build --force",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:commands": "cli-dev lint --cli dist/bin/memo.js",
    "release:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm lint:commands && pnpm secrets:scan",
    "prepare": "lefthook install || true",
    "postinstall": "node install/postinstall.mjs",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "prepublishOnly": "pnpm build",
    "standards:check": "node config/wirecat/check.mjs",
    "generate": "pnpm build && node --experimental-strip-types scripts/commands.ts",
    "generate:check": "pnpm build && node --experimental-strip-types scripts/commands.ts --check",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint --config cspell.json --no-progress README.md \"docs/*.md\"",
    "ci:quick": "pnpm typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "@valibot/to-json-schema": "1.8.0",
    "@wirecat/cli-base": "0.27.1",
    "@wirecat/cli-core": "0.265.0",
    "commander": "15.0.0",
    "postal-mime": "4.0.0",
    "valibot": "1.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cspell/dict-en-gb": "5.0.34",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.3",
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "5.0.3",
    "cspell": "10.3.6",
    "lefthook": "2.1.16",
    "markdownlint-cli2": "0.23.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
