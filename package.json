{
  "name": "@wirecat/cli-memo",
  "version": "0.89.0",
  "description": "Context about people across messengers, notes and mail, from a local store",
  "license": "Apache-2.0",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/cli-memo.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.20.0",
  "bin": {
    "memo": "dist/bin/memo.js"
  },
  "files": [
    "dist",
    "scenarios",
    "skills",
    "install",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build --force",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:commands": "cli-dev lint --cli dist/bin/memo.js",
    "release:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node --experimental-strip-types scripts/commands.ts --check && pnpm lint:commands && pnpm secrets:scan",
    "prepare": "lefthook install || true",
    "postinstall": "node install/postinstall.mjs",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "prepublishOnly": "pnpm build",
    "standards:check": "node config/wirecat/check.mjs",
    "generate": "pnpm build && node --experimental-strip-types scripts/commands.ts",
    "generate:check": "pnpm build && node --experimental-strip-types scripts/commands.ts --check",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint --config cspell.json --no-progress README.md \"docs/*.md\"",
    "ci:quick": "pnpm typecheck && pnpm build && pnpm lint:commands",
    "contracts:check": "cli-contract contracts/plan.json",
    "contracts:upgrade": "pnpm --dir contracts/previous install --frozen-lockfile --ignore-scripts && cli-contract contracts/upgrade.json",
    "security:no-leak": "cli-testing security no-leak . contracts/no-leak.json",
    "version:check": "cli-dev version",
    "version:sync": "cli-dev version --sync",
    "package:check": "node --experimental-strip-types scripts/package-check.ts",
    "docs:check": "cli-dev docs-check --rules scripts/docs-rules.ts --pages && cspell --no-progress --no-summary README.md 'docs/*.md' && pnpm docs:lint",
    "test:matrix:check": "cli-dev test-matrix --program scripts/command-program.ts --untested scripts/test-matrix-untested.ts --name memo && git diff --exit-code -- docs/dev/test-matrix.md",
    "test:matrix": "vitest run >/dev/null && pnpm build >/dev/null && pnpm test:matrix:check",
    "smoke:bun": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "@valibot/to-json-schema": "1.8.0",
    "@wirecat/cli-base": "0.49.0",
    "@wirecat/cli-core": "0.404.0",
    "commander": "15.0.0",
    "disposable-email-domains-js": "1.26.0",
    "postal-mime": "4.0.0",
    "tldts": "7.4.16",
    "valibot": "1.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cspell/dict-en-gb": "5.0.34",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.3",
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "5.0.3",
    "@wirecat/cli-testing": "0.5.2",
    "cspell": "10.3.6",
    "lefthook": "2.1.16",
    "markdownlint-cli2": "0.23.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
