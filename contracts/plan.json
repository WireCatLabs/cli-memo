{
  "command": "node",
  "args": ["../dist/bin/memo.js"],
  "cases": [
    {
      "id": "help",
      "args": ["--help"],
      "exit": 0,
      "stream": "stdout",
      "kind": "text",
      "snapshot": "help.snap"
    },
    {
      "id": "discovery",
      "args": ["commands", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "contains": "\"cli\":\"memo\""
    },
    {
      "id": "invalid-option",
      "args": ["--unknown-option"],
      "exit": 2,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "validation_error"
    },
    {
      "id": "invalid-command",
      "args": ["notes", "unknown-subcommand"],
      "exit": 2,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "validation_error"
    },
    {
      "id": "empty-store-lists-nothing",
      "args": ["notes", "list", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": {
        "items": []
      }
    },
    {
      "id": "forget-unknown-memory",
      "args": ["memories", "remove", "memory:999", "--json"],
      "exit": 6,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "not_found"
    },
    {
      "id": "forget-unknown-fact",
      "args": ["facts", "remove", "fact:999", "--json"],
      "exit": 6,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "not_found"
    },
    {
      "id": "reject-unknown-fact",
      "args": ["facts", "reject", "fact:999", "--json"],
      "exit": 6,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "not_found"
    },
    {
      "id": "moved-to-mail-cli",
      "args": ["mail", "rules", "add", "personal", "--domain", "news.example", "--do", "envelope", "--json"],
      "exit": 2,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "validation_error",
      "contains": "mail <profile> rules add"
    }
  ],
  "mcp": {
    "args": ["mcp", "serve"],
    "snapshot": "mcp-tools.json"
  }
}
