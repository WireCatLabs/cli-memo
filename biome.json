                  },
                  {
                    "group": ["@wirecat/*/src/**", "@wirecat/*/dist/**"],
                    "message": "use the WireCat packages through their public exports; their src and dist layout is not a contract"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/mcp/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
