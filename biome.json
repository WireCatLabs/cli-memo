{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./config/wirecat/biome.base.json"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/pnpm-lock.yaml",
      "!.worktrees",
      "!.claude",
      "!config/wirecat",
      "!lint/baseline"
    ]
  },
  "overrides": [
    {
      "includes": ["src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@modelcontextprotocol/**"],
                    "message": "only src/mcp serves MCP; commands and services do not know the protocol"
                  },
                  {
                    "group": ["yaml"],
                    "message": "front matter is read by the note dialects; the rest of memo gets parsed notes"
                  },
                  {
                    "group": ["@wirecat/cli-core/sqlite-runtime"],
                    "message": "the SQLite runtime is chosen once, at the entry point"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/mcp/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["yaml"],
                    "message": "front matter is read by the note dialects; the rest of memo gets parsed notes"
                  },
                  {
                    "group": ["@wirecat/cli-core/sqlite-runtime"],
                    "message": "the SQLite runtime is chosen once, at the entry point"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/notes/dialects/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@modelcontextprotocol/**"],
                    "message": "only src/mcp serves MCP; commands and services do not know the protocol"
                  },
                  {
                    "group": ["@wirecat/cli-core/sqlite-runtime"],
                    "message": "the SQLite runtime is chosen once, at the entry point"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/bin/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@modelcontextprotocol/**"],
                    "message": "only src/mcp serves MCP; commands and services do not know the protocol"
                  },
                  {
                    "group": ["yaml"],
                    "message": "front matter is read by the note dialects; the rest of memo gets parsed notes"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
