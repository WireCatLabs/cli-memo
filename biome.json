          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "test/**", "**/generated/**"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ]
}
